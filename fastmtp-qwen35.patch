diff --git a/src/llama-model.cpp b/src/llama-model.cpp
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -2329,6 +2329,31 @@ enum llama_mtp_package llama_model_mtp_package(const llama_model * model) {
     }
 
     const size_t n_nextn = model->hparams.nextn_predict_layers;
+
+    // Qwen3.5 normally embeds its MTP tail in the target model. A predictor-only
+    // companion keeps the full layer count in metadata but has no trunk tensors.
+    // Preserve the established embedded classification for complete Qwen3.5 files,
+    // including variants whose native tail does not carry an eh_proj tensor.
+    if (model->arch == LLM_ARCH_QWEN35 && n_nextn > 0) {
+        const size_t n_layers = model->layers.size();
+        if (n_nextn > n_layers) {
+            return LLAMA_MTP_PACKAGE_INVALID;
+        }
+
+        const size_t first = n_layers - n_nextn;
+        for (size_t il = 0; il < first; ++il) {
+            if (model->layers[il].attn_norm != nullptr) {
+                return LLAMA_MTP_PACKAGE_EMBEDDED;
+            }
+        }
+
+        const llama_layer & tail = model->layers[first];
+        const bool has_tail = tail.attn_norm != nullptr &&
+                              tail.nextn.enorm != nullptr &&
+                              tail.nextn.hnorm != nullptr;
+        return has_tail ? LLAMA_MTP_PACKAGE_COMPANION : LLAMA_MTP_PACKAGE_INVALID;
+    }
+
     const bool has_common_package_contract =
         llama_model_is_step35(model) || llama_model_is_deepseek4(model) ||
         llama_model_is_gemma4_mtp_assistant(model);
